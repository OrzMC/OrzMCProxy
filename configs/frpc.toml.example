# OrzMCProxy - frpc（家里）配置模板
# 用法：cp 到 /etc/orzmcproxy/frpc.toml（macOS: /usr/local/etc/orzmcproxy/frpc.toml）后修改
# 校验：frpc verify -c frpc.toml

# 中转机公网 IP / 域名
serverAddr = "CHANGE_ME_RELAY_IP"
serverPort = 7000

# token 认证（与 frps 一致）
auth.method = "token"
auth.token = "CHANGE_ME_STRONG_TOKEN"

# Java 主服 —— ⚠️ 真实 IP 透传：proxyProtocolVersion 必须配在 [proxies.transport]（frp ≥0.60 位置）
# 配套要求：Paper 端 paper-global.yml 开 proxies.proxy-protocol: true（不是 spigot.yml 的 bungeecord！）
# 开启后：服务器看到玩家真实 IP；直连（无 PROXY 头）会被服务器拒绝 → Geyser 需开 use-haproxy-protocol: true
[[proxies]]
name = "mc-java-main"
type = "tcp"
localIP = "127.0.0.1"
localPort = 25565
remotePort = 25565

[proxies.transport]
proxyProtocolVersion = "v2"

# Java 第二服（100 人双服分流）
[[proxies]]
name = "mc-java-second"
type = "tcp"
localIP = "127.0.0.1"
localPort = 25566
remotePort = 25566

[proxies.transport]
proxyProtocolVersion = "v2"

# 基岩版（Geyser，UDP 中转，2026-08-14 真机实测可行）
# ⚠️ UDP 代理不支持 PROXY protocol：不要配 [proxies.transport] proxyProtocolVersion！
#    Geyser bedrock 段 use-haproxy-protocol 必须保持 false（java 段正式档才开 true）
#    代价：UDP 中转无真实 IP 透传（Geyser 看到 127.0.0.1），基岩玩家 IP 级管控失效（XUID 不受影响）
[[proxies]]
name = "mc-bedrock"
type = "udp"
localIP = "127.0.0.1"
localPort = 19132
remotePort = 19132

# 可选：心跳调优（家里网络抖动时）
# transport.heartbeatInterval = 10
# transport.heartbeatTimeout = 30
