# OrzMCProxy frps - systemd 单元（中转机 Linux）
# 安装：sudo cp frps.service /etc/systemd/system/ && sudo systemctl daemon-reload
[Unit]
Description=OrzMCProxy frps (relay server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/frps -c /etc/orzmcproxy/frps.toml
Restart=always
RestartSec=3
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
