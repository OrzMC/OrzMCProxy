# OrzMCProxy frpc - systemd 单元（家里 Linux）
# 安装：sudo cp frpc.service /etc/systemd/system/ && sudo systemctl daemon-reload
[Unit]
Description=OrzMCProxy frpc (home tunnel client)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/frpc -c /etc/orzmcproxy/frpc.toml
Restart=always
RestartSec=3
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
