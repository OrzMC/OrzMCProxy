<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- OrzMCProxy frpc - macOS LaunchDaemon
     安装（sudo）：cp com.orzmc.frpc.plist /Library/LaunchDaemons/ && launchctl load /Library/LaunchDaemons/com.orzmc.frpc.plist
     卸载：launchctl unload /Library/LaunchDaemons/com.orzmc.frpc.plist -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.orzmc.frpc</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/frpc</string>
        <string>-c</string>
        <string>/usr/local/etc/orzmcproxy/frpc.toml</string>
    </array>

    <!-- 开机自启 + 崩溃自动拉起 -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- 日志 -->
    <key>StandardOutPath</key>
    <string>/usr/local/var/log/orzmcproxy/frpc.log</string>
    <key>StandardErrorPath</key>
    <string>/usr/local/var/log/orzmcproxy/frpc.log</string>
</dict>
</plist>
